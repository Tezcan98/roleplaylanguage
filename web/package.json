{
  "name": "@yilmaz/web",
  "version": "0.5.0",
  "private": true,
  "description": "Oyunun kendisi (three.js). Tarayıcıda ve mobil uygulamanın içinde aynı kod çalışır.",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs 8080",
    "voices": "node tools/fetch-voices.mjs",
    "check": "node tools/validate-content.mjs",
    "build": "vite build",
    "preview": "vite preview --port 8095",
    "playtest": "node tools/playtest/story.mjs",
    "playtest:smoke": "node tools/playtest/story.mjs --to=d1-afternoon",
    "playtest:multiplayer": "node tools/playtest/multiplayer.mjs",
    "playtest:offline": "npm run build && node tools/playtest/offline.mjs",
    "test": "npm run check && npm run playtest:smoke && npm run playtest:features && npm run playtest:multiplayer && npm run playtest:standalone && npm run playtest:offline",
    "playtest:standalone": "node tools/playtest/multiplayer.mjs --standalone",
    "playtest:features": "node tools/playtest/features.mjs",
    "i18n": "node tools/extract-glosses.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@yilmaz/server": "*",
    "playwright": "^1.63.0",
    "vite": "^8.3.2"
  }
}
