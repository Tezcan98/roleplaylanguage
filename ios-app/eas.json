{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "ios": {
        "scheme": "App",
        "buildConfiguration": "Release",
        "resourceClass": "m-medium",
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "simulator": {
      "extends": "production",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    }
  }
}
